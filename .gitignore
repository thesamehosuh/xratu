# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Build artifacts
dist/
out/
dist-tests/
*.vsix

# Playwright
test-results/
playwright-report/
# Screenshot review artifacts (regenerated by XRATU_SCREENSHOTS=1, never reviewed
# in a diff - a PNG in a PR is noise, not evidence).
test/e2e/screenshots/

# Dependencies (no trailing slash: also matches a node_modules symlink)
node_modules

# Logs
*.log
npm-debug.log*

# Env / secrets - this repo must never carry environment files
.env
.env.*
*.secrets.env

# Editor
.idea/
*.swp

# Machine-local agent tooling - never commit
.kilo/
.playwright-mcp/
kilo.json

# husky's generated hook shims. `.husky/pre-commit` IS committed (it is the
# actual rule); `_` is rewritten from the installed husky on every install by
# the `prepare` script, so committing it only churns on husky upgrades.
.husky/_/
