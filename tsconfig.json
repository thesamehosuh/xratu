{
    "compilerOptions": {
        "module": "commonjs",
        "paths": {
            "@opencode/client": ["./node_modules/@opencode/client/dist/promise/index"]
        },
        "target": "ES2022",
        "outDir": "out",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test",
        "out",
        "dist",
        "webview-ui",
        "vite.config.ts"
    ]
}
