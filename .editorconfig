# Editor-level consistency for everyone. This is deliberately the ONLY
# formatting contract: the repo does not use Prettier, because Prettier would
# reformat the whole tree (measured: 146 changed lines in src/paths.ts alone),
# which is a repo-wide churn PR, not a tooling change.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2
